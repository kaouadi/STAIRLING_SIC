  "type": "object",
  "$defs": {
    "number": {
      "$dynamicAnchor": "number",
      "description": "Nombre du bloc invoice. Ce schéma seul accepte un entier à l’échelle 2 ou une chaîne décimale ; l’enveloppe resserre ce point d’ancrage selon numeric_encoding (seulement des chaînes décimales en decimal).",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/decimal_string"
        }
      ]
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "amount": {
      "description": "EN 16931 Amount. Entier à l’échelle 2 (valeur × 100) si numeric_encoding le déclare, chaîne décimale sinon ; une chaîne reste admise en scaled_integer pour une valeur plus précise que deux décimales.",
      "$dynamicRef": "#number"
    },
    "unit_price_amount": {
      "description": "EN 16931 Unit Price Amount. Entier à l’échelle 2 (valeur × 100) si numeric_encoding le déclare, chaîne décimale sinon ; une chaîne reste admise en scaled_integer pour une valeur plus précise que deux décimales.",
      "$dynamicRef": "#number"
    },
    "percentage": {
      "description": "EN 16931 Percentage (1000 = 10,00 % à l’échelle 2). Entier à l’échelle 2 (valeur × 100) si numeric_encoding le déclare, chaîne décimale sinon ; une chaîne reste admise en scaled_integer pour une valeur plus précise que deux décimales.",
      "$dynamicRef": "#number"
    },
    "quantity": {
      "description": "EN 16931 Quantity (100 = 1 à l’échelle 2). Entier à l’échelle 2 (valeur × 100) si numeric_encoding le déclare, chaîne décimale sinon ; une chaîne reste admise en scaled_integer pour une valeur plus précise que deux décimales.",
      "$dynamicRef": "#number"
    },
    "amount_with_currency": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/amount"
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scheme_identifier": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "description": "Schéma ISO 6523 ICD (0002 SIREN, 0009 SIRET, 0225 annuaire FR)"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
